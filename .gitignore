.coverage
htmlcov/
coverage/

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
target/
.out

# Editors
.vscode/
.idea/
*.swp
*.swo

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/

# Original rules preserved
*.log
```